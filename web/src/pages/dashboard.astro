---
import Layout from '../layouts/Layout.astro';
import Dashboard from '../components/dash/Dashboard';
---

<Layout title="Hyberbola — hook console" description="Operate the Hyberbola v4 hook: quote book, auction preview, vault and rebalancing.">
	<Dashboard client:only="react" />
	<noscript>
		<p class="fallback">The hook console needs JavaScript to read from the chain.</p>
	</noscript>
</Layout>

<style is:global>
	.dash {
		max-width: 1240px;
		margin: 0 auto;
		padding: var(--step-3) var(--step-4) var(--step-6);
	}

	.dash-bar {
		display: flex;
		align-items: baseline;
		gap: var(--step-3);
		padding: var(--step-3) 0 var(--step-4);
		border-bottom: 1px solid var(--rule);
	}

	.dash-bar .mark {
		font-style: italic;
		font-size: 20px;
		letter-spacing: -0.02em;
	}

	.dash-title {
		color: var(--ink-faint);
	}

	.dash-actions {
		display: flex;
		align-items: center;
		gap: var(--step-2);
		margin-left: auto;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--step-3);
		margin-top: var(--step-4);
	}

	.panel {
		display: flex;
		flex-direction: column;
		gap: var(--step-2);
		padding: var(--step-3);
		border: 1px solid var(--rule);
		border-radius: 10px;
	}

	.panel-wide {
		grid-column: 1 / -1;
	}

	.panel > header {
		margin-bottom: var(--step-1);
	}

	.panel h2 {
		margin: 0 0 4px;
		font-size: 15px;
		font-weight: 300;
	}

	.panel > header p {
		max-width: 78ch;
		font-size: 13px;
		line-height: 1.5;
		color: var(--ink-faint);
	}

	.row {
		display: flex;
		gap: var(--step-2);
		padding: 5px 0;
		border-bottom: 1px solid rgba(38, 38, 38, 0.6);
		font-size: 13px;
	}

	.row-label {
		min-width: 12rem;
		color: var(--ink-faint);
	}

	.row-value {
		min-width: 0;
		overflow-wrap: anywhere;
	}

	.controls {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		gap: var(--step-2);
		padding: var(--step-2) 0;
	}

	.field {
		display: flex;
		flex: 1 1 14rem;
		flex-direction: column;
		gap: 4px;
		font-size: 12px;
	}

	.field > span {
		color: var(--ink-faint);
	}

	.field input,
	.field select,
	.dash-actions select {
		padding: 7px 9px;
		border: 1px solid var(--rule);
		border-radius: 6px;
		background: #131313;
		color: var(--ink);
		font: inherit;
		font-size: 13px;
	}

	.field input:focus,
	.field select:focus {
		border-color: #4a4a4a;
		outline: none;
	}

	.btn-row {
		display: flex;
		gap: var(--step-1);
	}

	.btn {
		padding: 7px 13px;
		border: 1px solid var(--rule);
		border-radius: 6px;
		background: none;
		color: var(--ink);
		font: inherit;
		font-size: 13px;
		cursor: pointer;
	}

	.btn:hover:not(:disabled) {
		border-color: #4a4a4a;
	}

	.btn:disabled {
		color: var(--ink-faint);
		cursor: not-allowed;
	}

	.btn-primary {
		border-color: transparent;
		background: var(--card);
		color: var(--card-ink);
	}

	.btn-primary:hover:not(:disabled) {
		background: #fff;
	}

	.link {
		border: 0;
		background: none;
		color: var(--ink);
		font: inherit;
		text-decoration: underline;
		cursor: pointer;
	}

	table {
		width: 100%;
		border-collapse: collapse;
		font-size: 13px;
	}

	th {
		padding: 6px 8px 6px 0;
		border-bottom: 1px solid var(--rule);
		color: var(--ink-faint);
		font-weight: 300;
		text-align: left;
	}

	td {
		padding: 6px 8px 6px 0;
		border-bottom: 1px solid rgba(38, 38, 38, 0.6);
	}

	.best {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--step-3);
		margin-top: var(--step-2);
	}

	.best-card {
		padding: var(--step-2);
		border: 1px solid var(--rule);
		border-radius: 8px;
	}

	.note {
		margin: 4px 0 0;
		font-size: 12px;
		line-height: 1.5;
		color: var(--ink-faint);
	}

	.note-warn {
		color: #d9a066;
	}

	.note-ok {
		color: #8fb87a;
	}

	.mono {
		font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
		font-size: 0.94em;
	}

	.dim {
		color: var(--ink-faint);
	}

	.ok {
		color: #8fb87a;
	}

	.fallback {
		padding: var(--step-4);
	}

	@media (max-width: 900px) {
		.grid,
		.best {
			grid-template-columns: minmax(0, 1fr);
		}

		.row {
			flex-direction: column;
			gap: 2px;
		}

		.row-label {
			min-width: 0;
		}
	}
</style>
