---
import { phrases } from '../lib/phrases';
---

<div class="marquee" aria-hidden="true" style={`--n: ${phrases.length}`}>
	{phrases.map((phrase, i) => <span class="phrase" style={`--i: ${i}`}>{phrase}</span>)}
</div>

<style>
	.marquee {
		--band: 30rem;
		--dur: 34s;
		--hole: calc(var(--hl-size) * var(--hl-lead) * 2 + 2.5rem);

		position: absolute;
		top: 50%;
		left: 48%;
		width: 52%;
		height: var(--band);
		transform: translateY(-50%);
		overflow: hidden;
		pointer-events: none;
		-webkit-mask-image: linear-gradient(
			180deg,
			transparent 0,
			#000 18%,
			#000 calc(50% - var(--hole) / 2),
			transparent calc(50% - var(--hole) / 2 + 1.5rem),
			transparent calc(50% + var(--hole) / 2 - 1.5rem),
			#000 calc(50% + var(--hole) / 2),
			#000 82%,
			transparent 100%
		);
		mask-image: linear-gradient(
			180deg,
			transparent 0,
			#000 18%,
			#000 calc(50% - var(--hole) / 2),
			transparent calc(50% - var(--hole) / 2 + 1.5rem),
			transparent calc(50% + var(--hole) / 2 - 1.5rem),
			#000 calc(50% + var(--hole) / 2),
			#000 82%,
			transparent 100%
		);
	}

	.phrase {
		position: absolute;
		top: 0;
		left: 3rem;
		white-space: nowrap;
		font-style: italic;
		font-size: 1.75rem;
		line-height: 1;
		letter-spacing: -0.015em;
		color: var(--ink-faint);
		will-change: transform, opacity;
		animation: rise var(--dur) linear infinite;
		animation-delay: calc(var(--dur) / var(--n) * var(--i) * -1);
	}

	@keyframes rise {
		0% {
			transform: translateY(var(--band)) scale(0.7);
			opacity: 0;
		}
		25% {
			transform: translateY(calc(var(--band) * 0.75 - 1rem)) scale(0.95);
			opacity: 0.6;
		}
		50% {
			transform: translateY(calc(var(--band) * 0.5 - 2rem)) scale(1.3);
			opacity: 1;
		}
		75% {
			transform: translateY(calc(var(--band) * 0.25 - 3rem)) scale(0.95);
			opacity: 0.6;
		}
		100% {
			transform: translateY(-4rem) scale(0.7);
			opacity: 0;
		}
	}

	@media (max-width: 900px) {
		.marquee {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.marquee {
			display: none;
		}
	}
</style>
