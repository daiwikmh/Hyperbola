# Copy to .env and fill in. Never commit the real .env file.

# RPC endpoint for the target chain.
RPC_URL=https://sepolia.unichain.org

# Deployer key. Prefer `--account <name>` / a keystore over a raw key where possible.
PRIVATE_KEY=

# Uniswap v4 addresses for the target chain.
# VERIFY every address on the chain's block explorer before a real deployment --
# https://developers.uniswap.org/contracts/v4/deployments
#
# Unichain Sepolia (1301) -- verified on-chain 2026-09
POOL_MANAGER=0x00b036b58a818b1bc34d502d3fe730db729e62ac
MODIFY_LIQUIDITY_ROUTER=0x5fa728c0a5cfd51bee4b060773f50554c0c8a7ab

# Largest fraction of an order the hook fills from its buffer (bps). Default 3000 = 30%.
MAX_FILL_BPS=3000
# Margin the hook keeps between the pool price and the runner-up belief (bps). Default 2000.
HOOK_EDGE_BPS=2000
SWAP_ROUTER=0x9140a78c1a137c7ff1c151ec8231272af78a99a4
#
# Ethereum Sepolia (11155111): POOL_MANAGER 0xE03A1074c86CFeDd5C142C4F04F1a1536e203543
# Base Sepolia (84532):        POOL_MANAGER 0x05E73354cFDd6745C338b50BcFDfA3Aa6fA03408

# Full-range liquidity delta seeded into the pool by script/Deploy.s.sol. Default 100e18.
LIQUIDITY=

# QuoteRegistry stake floor. Default 0.1 ETH; lower it for a thin-balance testnet demo.
MIN_STAKE=

# Block explorer API key for `forge script --verify` (Unichain uses a Blockscout instance).
ETHERSCAN_API_KEY=
