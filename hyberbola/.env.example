# Copy to .env and fill in. Never commit the real .env file.

# RPC endpoint for the target chain.
RPC_URL=

# Deployer key. Prefer `--account <name>` / a keystore over a raw key where possible.
PRIVATE_KEY=

# Uniswap v4 PoolManager address for the target chain.
# Addresses below are from https://docs.uniswap.org/contracts/v4/deployments as of Aug 2026 --
# VERIFY on the chain's block explorer before using in a real deployment.
#
# Unichain Sepolia (1301):  0x00B036B58a818B1BC34d502D3fB730Db729e62AC
# Ethereum Sepolia (11155111): 0xE03A1074c86CFeDd5C142C4F04F1a1536e203543
# Base Sepolia (84532):     0x05E73354cFDd6745C338b50BcFDfA3Aa6fA03408
POOL_MANAGER=

# Optional: fixed-tick fallback frontrun size for pools with no live registry quotes. Default 0 (no-op fallback).
FRONTRUN_TICKS=
